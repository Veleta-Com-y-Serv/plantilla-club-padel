---
// Portada a pantalla completa: foto de pista a sangre y, encima, panel azul cortado en diagonal con las líneas de una
// pista y una raya lima (en móvil, velo azul de abajo arriba). Título condensado en cursiva enorme (la última palabra en
// lima), `texto`, `cta` y `cta_secundario`; marcador con el próximo torneo (sale solo de la sección `torneos`) y franja
// lima en diagonal con `items: [{titulo, icono}]`. Sin foto, el panel ocupa todo.
import { seccion, proximoTorneo, partirFecha } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const titulo = (s?.titulo ?? '').trim();
const corte = titulo.lastIndexOf(' ');
const principio = corte > 0 ? titulo.slice(0, corte) : '';
const final = corte > 0 ? titulo.slice(corte + 1) : titulo;
const proximo = proximoTorneo();
const fecha = partirFecha(proximo?.fecha);
---

{
  s && (
    <section id={id} class:list={['portada', { 'portada--primera': primera, 'portada--sin-foto': !s.imagen }]}>
      {s.imagen && (
        <div class="portada-foto">
          <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad />
        </div>
      )}
      <div class="portada-panel" aria-hidden="true" />
      <div class="portada-raya" aria-hidden="true" />
      <div class="contenedor portada-cuerpo">
        <div class="portada-texto">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {titulo && (
            <h1 class="portada-titulo">
              {principio && `${principio} `}
              <span class="portada-final">{final}</span>
            </h1>
          )}
          {s.texto && <p class="portada-parrafo">{s.texto}</p>}
          {(s.cta || s.cta_secundario) && (
            <div class="botones mt-8">
              {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
              {s.cta_secundario && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
            </div>
          )}
        </div>
        {proximo && (
          <a class="marcador" href={`#${proximo.ancla}`}>
            <span class="marcador-cab">Próximo torneo</span>
            <span class="marcador-cuerpo">
              {fecha.dia && <span class="marcador-dia">{fecha.dia}</span>}
              {fecha.resto && <span class="marcador-mes">{fecha.resto}</span>}
            </span>
            <span class="marcador-titulo">{proximo.titulo}</span>
          </a>
        )}
      </div>
      {s.items.length > 0 && (
        <ul class="portada-cinta banda-lima">
          {s.items.map((it) => (
            <li>
              <Icono nombre={it.icono || 'pelota'} tam={26} />
              <span>{it.titulo}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .portada { position: relative; isolation: isolate; display: flex; flex-direction: column; min-height: calc(92svh - var(--alto-cabecera)); overflow: hidden; background: var(--c-primario); color: var(--sobre-primario); --resalte: var(--c-acento); --btn-fondo: var(--c-acento); --btn-texto: var(--sobre-acento); }
  .portada-foto { position: absolute; inset: 0; z-index: -3; }
  .portada-foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .portada-panel { position: absolute; inset: 0; z-index: -2; background:
      linear-gradient(to top, var(--c-primario) 0 30%, color-mix(in srgb, var(--c-primario) 78%, transparent) 55%, color-mix(in srgb, var(--c-primario) 10%, transparent) 100%); }
  .portada--sin-foto .portada-panel { background: var(--pista-blanca) 50% 50% / max(60rem, 140%) auto no-repeat, var(--c-primario); }
  .portada-raya { display: none; }
  .portada-cuerpo { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 2rem; padding-block: 3rem 2.5rem; }
  .portada-texto { max-width: 44rem; }
  .portada-titulo { margin-top: .9rem; font-size: clamp(2.9rem, 12vw, 7rem); line-height: .86; }
  .portada-final { color: var(--c-acento); }
  .portada-parrafo { margin-top: 1.25rem; max-width: 34rem; font-size: 1.15rem; }
  .marcador { display: none; }
  .portada-cinta { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem 1rem; padding: 2.25rem 1rem 1.25rem; clip-path: polygon(0 1rem, 100% 0, 100% 100%, 0 100%); }
  .portada-cinta li { display: flex; align-items: center; gap: .55rem; font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; font-weight: 700; text-transform: uppercase; font-size: 1.05rem; line-height: 1.05; }
  .portada-cinta :global(svg) { flex-shrink: 0; color: var(--c-primario); }

  @media (min-width: 900px) {
    .portada-panel { background: var(--pista-blanca) 0% 50% / auto 130% no-repeat, var(--c-primario); clip-path: polygon(0 0, 60% 0, 46% 100%, 0 100%); }
    .portada--sin-foto .portada-panel { clip-path: none; }
    .portada-raya { display: block; position: absolute; inset: 0; z-index: -1; background: var(--c-acento); clip-path: polygon(60% 0, 61.6% 0, 47.6% 100%, 46% 100%); }
    .portada--sin-foto .portada-raya { display: none; }
    .portada-cuerpo { flex-direction: row; align-items: center; justify-content: space-between; padding-block: 4rem; }
    .portada-texto { max-width: min(40rem, 44vw); }
    .portada-titulo { font-size: clamp(4rem, 7.4vw, 7rem); }
    .marcador { display: grid; align-self: flex-end; width: 15rem; text-decoration: none; background: var(--grafito); color: var(--sobre-grafito); border-radius: var(--radio); overflow: hidden; box-shadow: 8px 8px 0 var(--c-acento); transform: skewX(-6deg); transition: transform .2s ease; }
    .marcador:hover { transform: skewX(-6deg) translateY(-4px); }
    .marcador-cab { padding: .5rem 1rem; background: var(--c-acento); color: var(--sobre-acento); font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; font-size: .85rem; }
    .marcador-cuerpo { display: flex; align-items: baseline; gap: .6rem; padding: .75rem 1rem 0; }
    .marcador-dia { font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; font-size: 4.5rem; line-height: .9; color: var(--c-acento); font-variant-numeric: tabular-nums; }
    .marcador-mes { font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; text-transform: uppercase; font-size: 1.15rem; letter-spacing: .06em; }
    .marcador-titulo { padding: .5rem 1rem 1rem; font-weight: 600; line-height: 1.3; }
    .portada-cinta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; padding: 2.75rem max(2rem, calc((100% - 90rem) / 2 + 2rem)) 1.5rem; clip-path: polygon(0 1.5rem, 100% 0, 100% 100%, 0 100%); }
    .portada-cinta li { font-size: 1.5rem; }
  }
</style>
