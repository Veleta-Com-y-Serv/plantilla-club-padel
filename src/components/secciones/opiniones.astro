---
// Opiniones sobre grafito, entrando en diagonal: la primera en grande con comillas lima y las demás en columnas con raya
// lima encima (`testimonios: [{texto, autor, nota}]`). Sin opiniones no se pinta. No inventes opiniones.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const [primera, ...resto] = s?.testimonios ?? [];
---

{
  s && primera && (
    <section id={id} class="seccion banda-grafito corte opiniones">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
        <figure class="opinion-grande">
          <span class="opinion-comillas" aria-hidden="true">“</span>
          <blockquote><p>{primera.texto}</p></blockquote>
          <figcaption class="opinion-autor">
            <strong>{primera.autor}</strong>{primera.nota && <span> · {primera.nota}</span>}
          </figcaption>
        </figure>
        {resto.length > 0 && (
          <ul class="opiniones-rejilla">
            {resto.map((t) => (
              <li>
                <figure>
                  <blockquote><p class="opinion-texto">{t.texto}</p></blockquote>
                  <figcaption class="opinion-autor">
                    <strong>{t.autor}</strong>{t.nota && <span> · {t.nota}</span>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .opinion-grande { position: relative; margin-top: 2.5rem; max-width: 70rem; }
  .opinion-comillas { position: absolute; top: -.2em; left: -.05em; font-family: var(--fuente-titulos); font-weight: 700; font-size: clamp(8rem, 18vw, 14rem); line-height: 1; color: var(--c-acento); opacity: .9; pointer-events: none; }
  .opinion-grande blockquote { position: relative; padding-top: clamp(3.5rem, 8vw, 6rem); font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; font-weight: 700; text-transform: uppercase; font-size: clamp(1.9rem, 4.6vw, 3.75rem); line-height: 1; }
  .opinion-autor { margin-top: 1.25rem; font-size: 1rem; }
  .opinion-autor strong { font-family: var(--fuente-titulos); font-stretch: 75%; font-size: 1.15rem; text-transform: uppercase; letter-spacing: .08em; color: var(--c-acento); }
  .opiniones-rejilla { margin-top: 3.5rem; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .opiniones-rejilla { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 3rem; margin-top: 4.5rem; } }
  .opiniones-rejilla li { padding-top: 1.25rem; border-top: 4px solid var(--c-acento); }
  .opinion-texto { font-size: 1.15rem; line-height: 1.5; }
</style>
