---
// Cifras como marcador de partido sobre lima, entrando en diagonal: cada cifra en un cajetín grafito con el número en
// lima partido por la raya del marcador y la etiqueta debajo (`items: [{titulo: número, texto}]`). Sin cifras no se pinta.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const cifras = (s?.items ?? []).filter((c) => String(c.titulo ?? '').trim());
---

{
  s && cifras.length > 0 && (
    <section id={id} class="seccion banda-lima corte cifras">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
        <ul class="cifras-rejilla" style={`--n:${Math.min(cifras.length, 4)}`}>
          {cifras.map((c) => (
            <li>
              <p class="cifra-caja"><span>{c.titulo}</span></p>
              {c.texto && <p class="cifra-texto">{c.texto}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .cifras-rejilla { margin-top: 3rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
  @media (min-width: 1024px) { .cifras-rejilla { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 2rem; margin-top: 4rem; } }
  .cifra-caja { position: relative; display: grid; place-items: center; padding: 1.25rem .5rem; border-radius: var(--radio); background: var(--grafito); color: var(--c-acento); box-shadow: inset 0 -6px 0 color-mix(in srgb, var(--grafito) 70%, #000); overflow: hidden; }
  .cifra-caja::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: color-mix(in srgb, var(--grafito) 50%, #000); }
  .cifra-caja span { font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; font-size: clamp(3.5rem, 11vw, 7rem); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cifra-texto { margin-top: .9rem; font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; font-weight: 700; text-transform: uppercase; font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1; }
</style>
