---
// Instalaciones sobre claro: titular partido, servicios del club en cuatro columnas con icono en sello azul inclinado
// (`items: [{titulo, texto, icono}]`) y mosaico de fotos de borde a borde sin márgenes (`galeria: [ruta…]`; la primera
// grande; con 5 fotos el mosaico queda cerrado en escritorio). Sin fotos, sin mosaico.
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const fotos = s?.galeria ?? [];
---

{
  s && (
    <section id={id} class:list={['seccion banda-clara instalaciones', { 'instalaciones--mosaico': fotos.length > 0 }]}>
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
        {s.items.length > 0 && (
          <ul class="inst-items">
            {s.items.map((it) => (
              <li>
                <span class="inst-icono"><Icono nombre={it.icono || 'pelota'} tam={26} /></span>
                <h3 class="inst-titulo">{it.titulo}</h3>
                {it.texto && <p class="inst-texto">{it.texto}</p>}
              </li>
            ))}
          </ul>
        )}
        {s.cta && <p class="mt-10"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
      </div>
      {fotos.length > 0 && (
        <ul class:list={['inst-mosaico', { 'inst-mosaico--uno': fotos.length === 1 }]}>
          {fotos.map((f, i) => (
            <li class="foto-pista">
              <Imagen src={f} alt={altGaleria(i)} ancho={i === 0 ? 1200 : 720} alto={i === 0 ? 800 : 480} />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .instalaciones--mosaico { padding-bottom: 0 !important; }
  .inst-items { margin-top: 3rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  @media (min-width: 1024px) { .inst-items { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem; margin-top: 4rem; } }
  .inst-icono { display: inline-grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--radio); background: var(--c-primario); color: var(--sobre-primario); transform: skewX(-12deg); box-shadow: 4px 4px 0 var(--c-acento); }
  .inst-titulo { margin-top: 1.1rem; font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: .95; }
  .inst-texto { margin-top: .4rem; font-size: .95rem; opacity: .85; }
  .inst-mosaico { margin-top: 3.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 9.5rem; }
  .inst-mosaico li { overflow: hidden; }
  .inst-mosaico li:first-child { grid-column: span 2; grid-row: span 2; }
  .inst-mosaico--uno { grid-auto-rows: 16rem; }
  .inst-mosaico :global(img) { transition: transform .5s ease; }
  .inst-mosaico li:hover :global(img) { transform: scale(1.04); }
  @media (min-width: 768px) {
    .inst-mosaico { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(12rem, 17vw, 16rem); margin-top: 4.5rem; }
    .inst-mosaico--uno { grid-template-columns: 1fr; grid-auto-rows: clamp(20rem, 34vw, 32rem); }
    .inst-mosaico--uno li:first-child { grid-column: auto; grid-row: auto; }
  }
</style>
