---
// Tarifas de socio sobre grafito, entrando en diagonal inversa: titular partido y columnas a todo el ancho separadas por
// rayas (sin tarjetas): `tarifas: [{nombre, precio, periodo, incluye, destacado}]`; `incluye` con «;». La destacada va en
// bloque lima con la esquina cortada. Sin precio no hay precio. `cta` opcional.
import { seccion, puntos } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const tarifas = s?.tarifas ?? [];
---

{
  s && (
    <section id={id} class="seccion banda-grafito corte-inv tarifas">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
        {tarifas.length > 0 && (
          <ul class="tarifas-rejilla" style={`--n:${Math.min(tarifas.length, 4)}`}>
            {tarifas.map((t) => (
              <li class:list={['tarifa', { 'tarifa--destacada banda-lima': t.destacado === true }]}>
                <h3 class="tarifa-nombre">
                  {t.destacado === true && <Icono nombre="estrella" tam={22} class="inline-block align-[-2px] mr-1" />}
                  {t.nombre}
                </h3>
                {t.precio && (
                  <p class="tarifa-precio">
                    <span class="tarifa-cifra">{t.precio}</span>
                    {t.periodo && <span class="tarifa-periodo">{t.periodo}</span>}
                  </p>
                )}
                {puntos(t.incluye).length > 0 && (
                  <ul class="tarifa-incluye">
                    {puntos(t.incluye).map((p) => (
                      <li><Icono nombre="check" tam={20} class="shrink-0 resalte" />{p}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}
        {s.cta && <p class="mt-10"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
      </div>
    </section>
  )
}

<style>
  .tarifas-rejilla { margin-top: 3rem; display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .tarifas-rejilla { grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .tarifas-rejilla { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0; margin-top: 4rem; } }
  .tarifa { padding: 1.75rem 0 1.5rem; border-top: 4px solid var(--c-acento); }
  .tarifa--destacada { padding: 1.75rem 1.25rem 1.75rem; border-top: 0; border-radius: var(--radio); clip-path: polygon(0 0, calc(100% - 2.25rem) 0, 100% 2.25rem, 100% 100%, 0 100%); }
  @media (min-width: 1100px) {
    .tarifa { padding: 2rem 2.25rem 2.25rem; border-top: 0; border-left: 2px solid color-mix(in srgb, currentColor 20%, transparent); }
    .tarifa:first-child { border-left: 0; padding-left: 0; }
    .tarifa--destacada, .tarifa--destacada:first-child { padding: 2.25rem; border-left: 0; margin-block: -1.25rem; }
    .tarifa--destacada + .tarifa { border-left: 0; }
  }
  .tarifa-nombre { font-size: clamp(1.75rem, 2.6vw, 2.25rem); }
  .tarifa-precio { margin-top: 1rem; display: flex; align-items: baseline; flex-wrap: wrap; gap: .25rem .6rem; }
  .tarifa-cifra { font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; font-weight: 700; font-size: clamp(3.5rem, 6vw, 5rem); line-height: .9; color: var(--resalte); }
  .tarifa--destacada .tarifa-cifra { color: inherit; }
  .tarifa-periodo { font-family: var(--fuente-titulos); font-stretch: 75%; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; opacity: .85; }
  .tarifa-incluye { margin-top: 1.4rem; display: grid; gap: .6rem; }
  .tarifa-incluye li { display: flex; gap: .55rem; align-items: flex-start; line-height: 1.4; }
</style>
