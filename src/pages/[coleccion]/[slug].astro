---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /clases/<slug>/.
// Diseño «pista de competición»: banda azul con migas y hero partido (título condensado en cursiva con la última palabra
// en lima, texto, nivel, duración, precio y botones de reserva y WhatsApp; a la derecha la foto cortada en diagonal o,
// sin foto, el icono grande en un sello lima); banda clara con el `detalle` y, al lado, el marcador de datos y la
// caja de reserva; franja de fotos (`imagenes`) en banda grafito; y otras clases en banda clara2 con corte diagonal.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const palabras = f.titulo.trim().split(/\s+/);
const final = palabras.length > 1 ? palabras.pop() : '';
const inicio = palabras.join(' ');
const c = site.contacto;
const reserva = seccion('reservas') ? '/#reservas' : site.boton_cabecera?.url || '/#contacto';
const textoReserva = site.boton_cabecera?.texto || 'Reserva pista';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const duracion = f.datos.find((d) => d.clave === 'duracion')?.valor ?? '';
const nivel = f.datos.find((d) => d.clave === 'nivel')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'duracion');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-azul ficha-cabeza lineas-pista">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{inicio}{final && <> <span class="ficha-lima">{final}</span></>}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(nivel || duracion || f.precio) && (
            <p class="ficha-chips">
              {nivel && <span class="chip chip--contorno">{nivel}</span>}
              {duracion && <span class="chip chip--contorno"><Icono nombre="cronometro" tam={16} /> {duracion}</span>}
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={reserva}>{textoReserva}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto foto-pista">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-sello" aria-hidden="true"><Icono nombre={f.icono || 'pala'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda-clara ficha-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio || duracion) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">Datos de la clase</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {duracion && <div><dt>Duración</dt><dd>{duracion}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-reserva banda-lima">
          <p class="ficha-reserva-titulo">¿Probamos una clase?</p>
          <p>Cuéntanos tu nivel y te decimos qué grupo te encaja mejor.</p>
          <a class="btn" href={f.seccion.cta?.url || '/#contacto'}>{f.seccion.cta?.texto || 'Pide tu clase de prueba'}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-grafito ficha-banda" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-clara2 corte ficha-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras clases" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todas las clases</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3.5rem, 6vw, 5.5rem); clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--corte)), 0 100%); }
  .ficha-banda { padding-block: var(--ritmo); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .6; }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2rem, 8.5vw, 3.75rem); overflow-wrap: anywhere; }
  .ficha-lima { color: var(--c-acento); }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; font-weight: 700; font-size: 1.6rem; line-height: 1; color: var(--resalte-texto); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%); }
  .ficha-sello { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--c-acento); color: var(--sobre-acento); clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.6rem; margin-bottom: 1rem; font-style: italic; text-transform: uppercase; font-stretch: 75%; }
  .ficha-datos { background: var(--grafito); color: var(--sobre-grafito); padding: 1.5rem; border-top: .4rem solid var(--c-acento); }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .8rem 0; border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
  .ficha-datos dl > div:first-child { border-top: 0; }
  .ficha-datos dt { font-weight: 700; opacity: .75; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-datos .ficha-precio { color: var(--c-acento); }
  .ficha-reserva { display: grid; gap: .9rem; padding: 1.75rem 1.5rem 2.5rem; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.5rem), calc(100% - 1.5rem) 100%, 0 100%); }
  .ficha-reserva-titulo { font-family: var(--fuente-titulos); font-stretch: 75%; font-style: italic; text-transform: uppercase; font-size: 1.9rem; font-weight: 700; line-height: 1.05; }
  .ficha-reserva .btn { justify-self: start; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 36rem)); }
  .ficha-galeria li { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: .4rem solid var(--c-acento); }
  .ficha-otras { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; background: var(--c-fondo); border-top: .4rem solid var(--c-primario); transition: transform .2s ease; }
  .ficha-otra:hover { transform: translateY(-3px); }
  .ficha-otra h3 { font-size: 1.7rem; font-style: italic; text-transform: uppercase; font-stretch: 75%; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: 2px; }
  .ficha-otra p { opacity: .85; }
  .ficha-otra .ficha-precio { color: var(--c-primario); }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; color: var(--c-primario); }
  @media (min-width: 768px) { .ficha-banda { padding-block: var(--ritmo-md); } .ficha-banda.corte { padding-top: calc(var(--ritmo-md) + var(--corte)); } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
