---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda-azul lineas-pista">
    <div class="contenedor pt-16 pb-16 md:pt-24 md:pb-24">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo-seccion">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda-clara corte">
    <article class="contenedor max-w-3xl pb-16 md:pb-24 texto-largo">
      <h2>Quiénes somos</h2>
      <p>
        Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
          c.email || 'nuestro correo de contacto'
        }{c.telefono && ` o llamarnos al ${c.telefono}`}.
      </p>
      <h2>Qué datos tratamos</h2>
      <p>
        Solo los que nos envías al escribirnos: nombre, forma de contacto, lo que te interesa (reservas, clases, torneos o
        tarifas) y tu mensaje. Los usamos para responderte. No los cedemos a nadie salvo obligación legal.
      </p>
      <h2>Cuánto tiempo los guardamos</h2>
      <p>El necesario para atender tu consulta y, si te haces socio o te apuntas a clases, el que marque la ley.</p>
      <h2>Tus derechos</h2>
      <p>
        Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
        puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
      </p>
      <h2>Cookies</h2>
      <p>Esta web no usa cookies de seguimiento. Las reservas online, si las hay, se hacen en la web de reservas del club.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </article>
  </section>
</Base>

<style>
  .texto-largo h2 { font-size: 1.9rem; }
</style>
